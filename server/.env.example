# Backend-only template. For local development, use the project-root .env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# For a container-hosted backend, set HOST so the hosting proxy can reach it.
# Keep unset for local development.
# HOST=0.0.0.0
# For deployment, set this to your frontend origin.
FRONTEND_ORIGIN=http://localhost:5173
