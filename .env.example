# Copy this template to the project-root .env and replace the placeholders.
# VITE_ values are included in browser code; only use public frontend values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_GOOGLE_AUTH_ENABLED=false
# For a separately deployed frontend, set this to the public backend origin
# (no /api suffix), then rebuild/redeploy the frontend. Leave unset locally.
# VITE_RECOMMENDATION_API_URL=https://YOUR_BACKEND_ORIGIN

# Backend-only values. Never add the VITE_ prefix to secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
# For a container-hosted backend, set HOST so the hosting proxy can reach it.
# Keep unset for local development.
# HOST=0.0.0.0
# For deployment, set this to your frontend origin.
FRONTEND_ORIGIN=http://localhost:5173

# Optional: only needed by scripts/import-pc-components.mjs.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
